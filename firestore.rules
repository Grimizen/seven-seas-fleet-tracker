rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function memberPath() { return /databases/$(database)/documents/campaigns/seven-seas/members/$(request.auth.uid); }
    function member() { return signedIn() && exists(memberPath()) && get(memberPath()).data.role in ['owner','admin','member']; }
    function admin() { return member() && get(memberPath()).data.role in ['owner','admin']; }
    function owner() { return member() && get(memberPath()).data.role == 'owner'; }
    function count(n,max) { return n is int && n >= 0 && n <= max; }
    function station(s,max) { return count(s.hp,max) && count(s.assigned,10000); }
    function gun(g) { return g.condition in ['operational','disabled','destroyed'] && (g.loaded == null || (g.loaded is string && g.loaded.size() <= 80)) && count(g.assigned,48); }
    function valid(d,id) {
      let c = d.config;
      let g = d.game;
      let s = g.stations;
      return d.keys().hasOnly(['config','game','revision'])
        && c.id == id && c.name is string && c.name.size() > 0 && c.name.size() <= 60
        && c.type is string && c.type.size() > 0 && c.type.size() <= 60
        && count(c.maxHull,10000) && c.maxHull > 0 && count(c.minCrew,c.maxCrew) && count(c.maxCrew,10000)
        && c.get('archived',false) is bool
        && c.mounts is list && c.mounts.size() <= 100
        && c.stationMax.keys().hasOnly(['Bridge','Rudder','Mast','Gun Deck','Powder Dock','Anchors','Infirmary','Larder','Hold'])
        && g.keys().hasOnly(['hull','crew','crewLevel','sails','sinking','stations','guns','inventory','officers'])
        && count(g.hull,c.maxHull) && count(g.crew,c.maxCrew) && count(g.crewLevel,100)
        && g.sails in [0,1,2] && (g.sinking == null || count(g.sinking,12))
        && s.keys().hasOnly(c.stationMax.keys())
        && station(s['Bridge'],c.stationMax['Bridge']) && station(s['Rudder'],c.stationMax['Rudder']) && station(s['Mast'],c.stationMax['Mast']) && station(s['Gun Deck'],c.stationMax['Gun Deck'])
        && station(s['Powder Dock'],c.stationMax['Powder Dock']) && station(s['Anchors'],c.stationMax['Anchors']) && station(s['Infirmary'],c.stationMax['Infirmary']) && station(s['Larder'],c.stationMax['Larder']) && station(s['Hold'],c.stationMax['Hold'])
        && g.guns is list && g.guns.size() == c.mounts.size()
        && g.inventory is list && g.inventory.size() <= 500 && g.officers is map
        && d.revision is int && d.revision >= 0;
    }
    match /campaigns/seven-seas/members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      // The first owner is created through the Firebase Console, never by a public client.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['role','email','displayName'])
        && request.resource.data.keys().hasOnly(['role','email','displayName'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
        && request.resource.data.role in ['admin','member']
        && exists(/databases/$(database)/documents/campaigns/seven-seas/invites/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/campaigns/seven-seas/invites/$(request.auth.token.email.lower())).data.role == request.resource.data.role;
      allow update: if owner() && resource.data.role != 'owner' && request.resource.data.role in ['admin','member','revoked']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
      allow delete: if false;
    }
    match /campaigns/seven-seas/invites/{email} {
      allow get: if signedIn() && (request.auth.token.email.lower() == email || admin());
      allow list: if admin();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['role']) && request.resource.data.role in ['admin','member'];
      allow delete: if admin();
    }
    match /campaigns/seven-seas/ships/{id} {
      allow read: if member();
      allow create: if admin() && valid(request.resource.data,id) && request.resource.data.revision == 0;
      allow update: if member() && valid(request.resource.data,id)
        && (admin() || (!resource.data.config.get('archived',false) && request.resource.data.config == resource.data.config));
      allow delete: if false;
    }
    match /campaigns/seven-seas/settings/templates {
      allow read: if admin();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 50;
      allow delete: if false;
    }
    match /campaigns/seven-seas/activity/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.keys().hasOnly(['actor','text','at'])
        && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      allow update, delete: if false;
    }
  }
}
